# 本地渠道配置模板（本地开发者模式专用）
#
# 用法：
#   cp .env.local.example .env.local     # .env.local 已被 .gitignore 忽略
#   npm run local                        # 重启后生效
#
# 全部可以留空——空着就是「本地占位图 + 本地模拟回复」，零配置也能跑通
# 生图、图生图、历史、小说可视化的完整链路。只有想接真实渠道时才填下面的值。
# 键名与线上 Go 服务的环境变量保持一致，方便两边互相复制。

# ── 本地服务 ──
# 本地 API 监听地址与端口（默认 127.0.0.1:8000，只监听本机）
# LOCAL_API_HOST=127.0.0.1
# LOCAL_API_PORT=8000
# 数据目录（默认仓库根目录下的 local-data/）
# LOCAL_DATA_DIR=local-data
# 模拟生图耗时，毫秒；调成 0 可以立刻返回（默认 900）
# LOCAL_IMAGE_DELAY_MS=900
# 默认出图尺寸（工作台未指定时使用）
# LOCAL_IMAGE_SIZE=1024x1024

# ── 生图渠道（可选）──
# 填了这三项就会真正调用图片接口；留空则本地合成占位图。
# PROVIDER_BASE_URL=https://api.openai.com
# PROVIDER_API_PATH=/v1/images/generations
# PROVIDER_MODEL_NAME=gpt-image-2
# PROVIDER_API_KEY=
# PROVIDER_TIMEOUT_SECONDS=300

# ── 对话 / 小说分析渠道（可选）──
# 填了这三项，工作台对话与小说场景分析都会走真实 LLM；留空则用本地模拟。
# LLM_BASE_URL=https://api.openai.com
# LLM_API_PATH=/v1/chat/completions
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=300

# ── 小说可视化 ──
# 自动模式最多挑几个场景（默认 6），场景图并发生成数（默认 3）
# NOVELVIZ_MAX_SCENES=6
# NOVELVIZ_IMAGE_CONCURRENCY=3

# ── ComfyUI 本地生图（工作台的「Comfy 生图」板块，仅本地模式存在）──
# 板块只在 npm run local / npm run dev:workspace 下出现；线上部署不显示、也不会调用本机进程。
# ComfyUI 地址（默认就是本机 8188）
# COMFY_BASE_URL=http://127.0.0.1:8188
# 「启动 ComfyUI」按钮执行的命令：可以直接填启动脚本的完整路径（路径含空格也没问题），
# 也可以填一段 shell 命令；留空则按钮会提示手动启动。Windows 示例：
# COMFY_START_CMD=D:\Users\25657\Desktop\Comfy\start-comfyui.bat
# 单张超时（毫秒，默认 15 分钟；6 步模型一般约 15 秒，官方 25 步约 1 分钟）
# COMFY_TIMEOUT_MS=900000
# 每张图前先卸载模型释放显存（默认 0 关闭；8GB 显存连续出图不稳时可设 1，
# 代价是每张都要重新加载约 16.5GB 权重）
# COMFY_FREE_MEMORY=0

# ── 单端口页面托管 ──
# npm run local 是一个进程一个端口：工作台在 /、管理台在 /admin，Vite 以 middleware
# 方式挂在同一个 HTTP 服务上，不需要额外端口。只有在退回到「npm run local:api +
# npm run dev:workspace / dev:console」分开启动时，才需要让 Vite 知道本地 API 在哪：
# LOCAL_API_TARGET=http://127.0.0.1:8000
