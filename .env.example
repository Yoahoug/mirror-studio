# Mirror Studio / 绘镜 - 最小公开部署配置
# 复制为 .env 后再填写真实值；不要提交 .env。

# 基础站点
SECRET_KEY=replace-with-a-long-random-string
DEBUG=0
PUBLIC_ORIGIN=https://image.example.com
HTTP_PORT=8000
TIME_ZONE=Asia/Shanghai
LANGUAGE_CODE=zh-hans

# 多域名部署时才需要手动覆盖；默认会从 PUBLIC_ORIGIN 自动推导。
# ALLOWED_HOSTS=image.example.com,www.image.example.com
# CSRF_TRUSTED_ORIGINS=https://image.example.com,https://www.image.example.com

# 数据库
# 如果密码要拼进 DATABASE_URL，建议只用字母、数字、下划线，避免 URL 转义问题。
POSTGRES_DB=mirror_studio
POSTGRES_USER=mirror_studio
POSTGRES_PASSWORD=changeThisDbPassword123
DATABASE_URL=postgresql://mirror_studio:changeThisDbPassword123@postgres:5432/mirror_studio

# 初始化
AUTO_APPLY_MIGRATIONS=1
AUTO_SEED_SITECONFIG=1
AUTO_INIT_APP_DATA=1
AUTO_COLLECTSTATIC=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeThisAdminPassword123
ADMIN_EMAIL=admin@example.com

# 生图渠道（OpenAI-Compatible）
MOCK_PROVIDER_ENABLED=0
DEFAULT_CHANNEL_CODE=default
PROVIDER_NAME=默认图片渠道
PROVIDER_VENDOR=OpenAI-Compatible
PROVIDER_BASE_URL=https://your-image-provider.example.com
PROVIDER_API_PATH=/v1/images/generations
PROVIDER_MODEL_NAME=gpt-image-2
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=300
PROVIDER_MAX_RETRIES=1

# 小说分析 LLM 渠道（OpenAI-Compatible）
LLM_CHANNEL_CODE=default-llm
LLM_PROVIDER_NAME=默认 LLM 渠道
LLM_PROVIDER_VENDOR=OpenAI-Compatible
LLM_BASE_URL=https://your-llm-provider.example.com
LLM_API_PATH=/v1/chat/completions
LLM_MODEL_NAME=gpt-5.4
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3

# 邮件 SMTP；QQ 邮箱请填写 SMTP 授权码，不是登录密码。
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=your_qq@qq.com
EMAIL_HOST_PASSWORD=your_qq_smtp_auth_code
DEFAULT_FROM_EMAIL=绘镜 Studio <your_qq@qq.com>

# 免费额度与注册
REGISTER_ENABLED=1
LOGIN_CAPTCHA_ENABLED=1
EMAIL_VERIFICATION_ENABLED=1
DEFAULT_DAILY_FREE_QUOTA=3
DAILY_USER_TASK_LIMIT=50
MAX_PENDING_TASKS=3
IMAGE_RETENTION_DAYS=30

# 上传与小说可视化
RESUMABLE_UPLOAD_CHUNK_SIZE=8388608
RESUMABLE_UPLOAD_SESSION_TTL_SECONDS=86400
MAX_REFERENCE_IMAGE_BYTES=10485760
NOVELVIZ_MAX_EPUB_UPLOAD_BYTES=83886080
NOVELVIZ_IMAGE_SIZE=1024x1024
NOVELVIZ_IMAGE_QUALITY=high
NOVELVIZ_IMAGE_CONCURRENCY=3
NOVELVIZ_MAX_SCENES=10

# 本地文件存储；公开轻量部署默认不需要独立 MinIO。
MINIO_USE_LOCAL_FS=1
MINIO_LOCAL_ROOT=media/minio
MINIO_BUCKET=generated-images

# 生产安全 / 反代
FIELD_CRYPT_KEY=
USE_X_FORWARDED_HOST=1
TRUST_X_FORWARDED_FOR=0
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

# 后台任务与 Gunicorn
GENERATION_TASKS_RUN_INLINE=0
GENERATION_WORKER_POLL_SECONDS=2
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=10