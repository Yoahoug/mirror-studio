# ── 必填 ──
# 会话与签名密钥，至少 32 字符；生产环境务必替换
SECRET_KEY=please-change-me-to-a-random-32-char-string
# 渠道密钥的字段加密密钥；为空将拒绝启动（不再明文落库）
FIELD_CRYPT_KEY=please-change-me-field-crypt-key
# 站点对外地址（含协议与端口，不带路径）
PUBLIC_ORIGIN=https://image.example.com

# ── 运行 ──
DEBUG=0
# 监听端口：供默认监听地址（0.0.0.0:<APP_PORT>）与 DEBUG 下的兜底 PUBLIC_ORIGIN 使用
APP_PORT=8000
# 完整监听地址（如 127.0.0.1:8000）；留空则用上面的默认地址，启动参数 -listen 优先
APP_LISTEN=
TIME_ZONE=Asia/Shanghai
DATABASE_URL=sqlite:////app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
NOVELVIZ_BOOK_DIR=/app/data/novel
REGISTER_ENABLED=1
LOGIN_CAPTCHA_ENABLED=1

# 反向代理协议头（Cloudflare Tunnel / Nginx 前置时保持为 1）
USE_X_FORWARDED_HOST=1
# 仅当反向代理会覆盖 X-Forwarded-For 时才置 1，否则客户端可伪造来源 IP
TRUST_X_FORWARDED_FOR=0

# ── 管理员初始化（首次启动创建或重置） ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
ADMIN_EMAIL=admin@example.com

# ── 图片渠道（默认生图渠道） ──
DEFAULT_CHANNEL_CODE=default
PROVIDER_NAME=默认图片渠道
PROVIDER_VENDOR=OpenAI-Compatible
PROVIDER_VENDOR_CODE=openai
PROVIDER_BASE_URL=https://api.openai.com
PROVIDER_API_PATH=/v1/images/generations
PROVIDER_MODEL_NAME=gpt-image-1
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=300
PROVIDER_MAX_RETRIES=1

# ── LLM 渠道（工作台对话与小说场景分析） ──
LLM_CHANNEL_CODE=default-llm
LLM_PROVIDER_NAME=默认 LLM 渠道
LLM_BASE_URL=https://api.openai.com
LLM_API_PATH=/v1/chat/completions
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=3

# ── 小说可视化 ──
NOVELVIZ_API_BASE_URL=https://api.openai.com
NOVELVIZ_IMAGE_MODEL=gpt-image-1
NOVELVIZ_IMAGE_API_PATH=/v1/images/generations
NOVELVIZ_IMAGE_API_KEY=
NOVELVIZ_IMAGE_SIZE=1024x1024
NOVELVIZ_IMAGE_QUALITY=high
NOVELVIZ_MAX_SCENES=10
NOVELVIZ_IMAGE_CONCURRENCY=3
NOVELVIZ_SSE_POLL_SECONDS=1

# ── 邮件（注册验证码） ──
EMAIL_VERIFICATION_ENABLED=0
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=1
DEFAULT_FROM_EMAIL=noreply@example.com

# ── 额度与风控 ──
DEFAULT_DAILY_FREE_QUOTA=3
DAILY_USER_TASK_LIMIT=50
MAX_PENDING_TASKS=3
RISK_LOGIN_FAIL_LIMIT=5
RISK_LOGIN_LOCK_MINUTES=15
RISK_TASK_WINDOW_SECONDS=60
RISK_TASK_LIMIT_PER_WINDOW=10
CONSOLE_API_RATE_LIMIT=60

# ── 开发/测试专用（生产禁止开启） ──
MOCK_PROVIDER_ENABLED=0
